{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy your home match plan and its alerts into your calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere deinen Heimspielplan mit Erinnerungen in deinen Kalender."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie seu plano do jogo e alertas para o calendário."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez votre projet de match et ses rappels dans votre calendrier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia tu plan de partido y avisos al calendario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia il programma della partita e gli avvisi nel calendario."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте план домашнего матча и напоминания в свой календарь."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a calendar copy of your match with arrival and day-before reminders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen Kalendereintrag mit Erinnerungen am Vortag und zur Ankunft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma cópia do jogo com lembretes na véspera e na chegada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une copie du match avec rappels la veille et à l’arrivée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una copia del partido con avisos el día anterior y al llegar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una copia della partita con avvisi il giorno prima e all’arrivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте копию матча в календаре с напоминаниями за день и к прибытию."
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep unfinished matchday items in a reminder list you control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte offene Spieltag-Punkte in deiner Erinnerungsliste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde itens pendentes em uma lista de lembretes sob seu controle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les éléments restants dans votre liste de rappels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda elementos pendientes en tu lista de recordatorios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva gli elementi mancanti nella tua lista di promemoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните невыполненные пункты матчдэя в своём списке напоминаний."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create and update your exported matchday checklist in Apple Reminders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle und aktualisiere deine exportierte Spieltag-Liste in Apple Erinnerungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie e atualize a lista exportada no app Lembretes Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez et actualisez votre liste exportée dans Rappels Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea y actualiza la lista exportada en Recordatorios de Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea e aggiorna la lista esportata in Promemoria Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте и обновляйте экспортированный чек-лист в Напоминаниях Apple."
          }
        }
      }
    },
