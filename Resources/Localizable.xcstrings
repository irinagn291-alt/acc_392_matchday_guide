    "Weather requests send a stadium coordinate to MET Norway; the provider receives your IP address. Private iCloud sync sends only favorites and notes to your Apple account. Calendar and Reminders are accessed only after your action and permission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Bright Sky receives the stadium coordinates, match date and your IP address. Notes and favourites stay on this device until shared."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Aktivierung erhält Bright Sky Stadionkoordinaten, Spieltermin und IP-Adresse. Notizen und Favoriten bleiben bis zur Freigabe auf dem Gerät."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Bright Sky recebe as coordenadas do estádio, a data e o IP. Notas e favoritos ficam no aparelho até o compartilhamento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, Bright Sky reçoit les coordonnées du stade, la date et l’adresse IP. Notes et favoris restent sur cet appareil sauf partage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarse, Bright Sky recibe las coordenadas del estadio, la fecha y la IP. Notas y favoritos quedan en el dispositivo hasta que se compartan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, Bright Sky riceve coordinate dello stadio, data e indirizzo IP. Note e preferiti restano sul dispositivo fino alla condivisione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включении Bright Sky получает координаты стадиона, дату матча и IP-адрес. Заметки и избранное остаются на устройстве до экспорта."
          }
        }
      }
    },
    "Offline first": {
      "extractionState": "manual",
      "localizations": {
