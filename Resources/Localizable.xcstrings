            "value": "Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте файл или отправьте копию напрямую. Изменения останутся на устройстве до следующей отправки."
          }
        }
      }
    },
    "iCloud could not sync. Local data is saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Local data is saved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Lokale Daten sind gespeichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. Dados locais salvos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Données locales conservées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos. Datos locales guardados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un file o invia una copia direttamente. Le modifiche restano sul dispositivo fino alla condivisione successiva. Dati locali salvati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте файл или отправьте копию напрямую. Изменения останутся на устройстве до следующей отправки. Локальные данные сохранены."
          }
        }
      }
    },
    "The next 24 matches are scheduled when you open the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next 24 matches are scheduled when you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächsten 24 Spiele werden beim Öffnen der App geplant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os próximos 24 jogos são agendados ao abrir o app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 24 prochains matchs sont programmés à l’ouverture de l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los próximos 24 partidos se programan al abrir la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prossime 24 partite sono pianificate aprendo l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания для 24 ближайших матчей планируются при открытии приложения."
          }
        }
      }
    },
    "Read your sector": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read your sector"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinen Block verstehen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entenda seu setor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprendre votre secteur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiende tu sector"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi il tuo settore"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как читать свой сектор"
          }
        }
      }
    },
    "wem.sectors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first digit of your block indicates the level: 1, 2 or 5. Areas 3 and 4 contain boxes. Use the level on your admission pass."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Ziffer deines Blocks bezeichnet die Ebene: 1, 2 oder 5. Die Bereiche 3 und 4 enthalten Logen. Bleibe auf der Ebene deines Eintrittsnachweises."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro dígito do bloco indica o nível: 1, 2 ou 5. As áreas 3 e 4 são de camarotes. Use o nível indicado no ingresso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier chiffre du bloc indique le niveau : 1, 2 ou 5. Les zones 3 et 4 sont des loges. Restez au niveau de votre titre d’entrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer dígito del bloque indica el nivel: 1, 2 o 5. Las zonas 3 y 4 son palcos. Usa el nivel de tu entrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima cifra del blocco indica il livello: 1, 2 o 5. Le zone 3 e 4 sono palchi. Usa il livello del titolo di accesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая цифра номера блока указывает уровень: 1, 2 или 5. На уровнях 3 и 4 находятся ложи. Используйте уровень своего пропуска."
          }
        }
      }
    },
    "oly.sectors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower-tier blocks use letters; upper-tier blocks use numbers. Copy the exact block, row and seat from your admission pass."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Unterrang nutzt Buchstaben für die Blöcke, der Oberrang Zahlen. Übernimm Block, Reihe und Platz genau von deinem Eintrittsnachweis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anel inferior usa letras nos blocos; o superior usa números. Copie o bloco, a fila e o assento exatamente do ingresso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les blocs du niveau bas portent des lettres, ceux du niveau haut des chiffres. Recopiez exactement bloc, rang et place de votre titre d’entrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los bloques inferiores usan letras y los superiores números. Copia exactamente bloque, fila y asiento de tu entrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I blocchi inferiori usano lettere, quelli superiori numeri. Copia esattamente blocco, fila e posto dal titolo di accesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижний ярус использует буквы для блоков, верхний — числа. Точно перепишите блок, ряд и место со своего пропуска."
          }
        }
      }
    },
    "sdf.sectors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower, middle and upper tiers include lateral stands and curves. Your admission pass determines your block, row and seat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt einen unteren, mittleren und oberen Rang mit Seiten- und Kurvenbereichen. Dein Eintrittsnachweis bestimmt Block, Reihe und Platz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há anéis inferior, intermediário e superior, com laterais e curvas. O ingresso determina bloco, fila e assento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stade comprend des niveaux bas, intermédiaire et haut, avec tribunes latérales et virages. Votre titre d’entrée précise bloc, rang et place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay niveles inferior, medio y superior, con laterales y curvas. Tu entrada indica bloque, fila y asiento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono livelli inferiore, intermedio e superiore, con tribune laterali e curve. Il titolo indica blocco, fila e posto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть нижний, средний и верхний ярусы, боковые трибуны и виражи. Блок, ряд и место определяются вашим пропуском."
          }
        }
      }
    },
