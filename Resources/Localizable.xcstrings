    "Start within eight hours of kickoff. The timer runs offline; system limits apply.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start within eight hours of kickoff. The timer runs offline; system limits apply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte frühestens acht Stunden vor Anstoß. Der Timer läuft offline; Systemgrenzen gelten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie nas oito horas antes do jogo. O contador funciona offline, sujeito aos limites do sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez dans les huit heures avant le début. Le minuteur fonctionne hors ligne, selon les limites système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia en las ocho horas previas. El contador funciona sin conexión con los límites del sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia nelle otto ore prima dell’inizio. Il timer funziona offline con i limiti di sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте за восемь часов до начала или позже. Таймер работает офлайн с учётом ограничений системы."
          }
        }
      }
    },
