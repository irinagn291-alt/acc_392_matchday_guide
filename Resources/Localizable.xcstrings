    "Plans, checklists, notes and weather caches are stored locally. Removing the app removes local data. No analytics or advertising SDKs are included.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans, checklists, notes and weather caches are stored locally. Removing the app removes local data. No analytics or advertising SDKs are included."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pläne, Listen, Notizen und Wetter werden lokal gespeichert. Das Löschen der App entfernt lokale Daten. Keine Analyse- oder Werbe-SDKs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planos, listas, notas e previsões ficam locais. Excluir o app apaga os dados locais. Sem SDKs de análise ou anúncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projets, listes, notes et météo sont stockés localement. Supprimer l’app efface ces données. Aucun SDK d’analyse ou de publicité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planes, listas, notas y tiempo se guardan localmente. Eliminar la app borra los datos locales. Sin SDK de análisis ni anuncios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmi, liste, note e meteo sono locali. Eliminare l’app rimuove i dati locali. Nessun SDK di analisi o pubblicità."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планы, чек-листы, заметки и погода хранятся локально. Удаление приложения удаляет эти данные. SDK аналитики и рекламы отсутствуют."
          }
        }
      }
    },
