    "Together we rise, together we sing.\nOne crowd, one day, let our voices ring.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Together we rise, together we sing.\nOne crowd, one day, let our voices ring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammen stehen wir, zusammen singen wir.\nEin Tag, ein Chor, die Stimmen klingen hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Juntos de pé, juntos a cantar.\nUma torcida, um dia, nossas vozes pelo ar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensemble debout, ensemble on chante.\nUne foule, un jour, nos voix vibrantes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juntos en pie, juntos al cantar.\nUna afición, un día, voces a sonar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Insieme in piedi, insieme a cantare.\nUn pubblico, un giorno, le voci a risuonare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе встаём, вместе поём.\nОдна трибуна, один день — голос звучит над полем."
          }
        }
      }
    },
