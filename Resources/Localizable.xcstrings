    "Get a reminder the day before a match and at your planned arrival. Weather notices appear only after an update. Background updates are scheduled by iOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a reminder the day before a match and at your planned arrival. Weather notices appear only after an update. Background updates are scheduled by iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen am Vortag und zur Ankunft. Wetterhinweise erst nach einer Aktualisierung. iOS plant Hintergrundabrufe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba lembretes na véspera e na chegada. Avisos do tempo só após atualizar. O iOS agenda atualizações em segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels la veille et à l’arrivée. Avis météo après actualisation seulement. iOS gère les actualisations en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe avisos el día anterior y al llegar. La meteorología avisa tras actualizar. iOS programa las actualizaciones en segundo plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisi il giorno prima e all’arrivo. Notifiche meteo solo dopo un aggiornamento. iOS pianifica gli aggiornamenti in background."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания за день и ко времени прибытия. Уведомления о погоде появляются только после обновления. Фоновую работу планирует iOS."
          }
        }
      }
    },
