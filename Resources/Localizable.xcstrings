    "wem.travel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wembley Park: Jubilee and Metropolitan lines. Wembley Stadium: Chiltern Railways. Wembley Central: Bakerloo and Overground. Follow event signs from the station; queues can be long after the final whistle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wembley Park: Jubilee und Metropolitan. Wembley Stadium: Chiltern Railways. Wembley Central: Bakerloo und Overground. Folge den Schildern ab dem Bahnhof; nach dem Spiel kann es lange Schlangen geben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Wembley Park: Jubilee e Metropolitan. Wembley Stadium: Chiltern Railways. Wembley Central: Bakerloo e Overground. Siga as placas do evento; pode haver filas após o jogo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wembley Park : Jubilee et Metropolitan. Wembley Stadium : Chiltern Railways. Wembley Central : Bakerloo et Overground. Suivez les panneaux ; les files peuvent être longues après le match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wembley Park: Jubilee y Metropolitan. Wembley Stadium: Chiltern Railways. Wembley Central: Bakerloo y Overground. Sigue las señales; puede haber colas tras el partido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wembley Park: Jubilee e Metropolitan. Wembley Stadium: Chiltern Railways. Wembley Central: Bakerloo e Overground. Segui la segnaletica; dopo la partita sono possibili lunghe code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wembley Park: линии Jubilee и Metropolitan. Wembley Stadium: Chiltern Railways. Wembley Central: Bakerloo и Overground. Следуйте указателям; после матча возможны длинные очереди."
          }
        }
      }
    },
    "oly.travel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "U2 to Olympia-Stadion, or S3 / S9 to Olympiastadion. Follow signs to the entrance shown on your pass. Allow extra walking time around the stadium perimeter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "U2 bis Olympia-Stadion oder S3 / S9 bis Olympiastadion. Folge den Schildern zum Eingang auf deinem Eintrittsnachweis. Plane zusätzliche Gehzeit am Stadion ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "U2 até Olympia-Stadion ou S3 / S9 até Olympiastadion. Siga as placas até a entrada do ingresso. Reserve tempo para caminhar ao redor do estádio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "U2 jusqu’à Olympia-Stadion ou S3 / S9 jusqu’à Olympiastadion. Suivez les panneaux vers votre entrée. Prévoyez du temps pour contourner le stade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "U2 a Olympia-Stadion o S3 / S9 a Olympiastadion. Sigue las señales hacia tu entrada. Prevé tiempo para rodear el estadio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "U2 fino a Olympia-Stadion oppure S3 / S9 fino a Olympiastadion. Segui i cartelli per il tuo ingresso. Prevedi tempo per camminare attorno allo stadio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "U2 до Olympia-Stadion или S3 / S9 до Olympiastadion. Следуйте указателям к входу на вашем пропуске. Учтите время на обход стадиона."
          }
        }
      }
    },
    "sdf.travel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RER B to La Plaine–Stade de France, or RER D to Stade de France–Saint-Denis. Continue on foot using event signs. Check return services before setting out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RER B bis La Plaine–Stade de France oder RER D bis Stade de France–Saint-Denis. Folge zu Fuß den Veranstaltungsschildern. Prüfe die Rückfahrt vor der Abreise."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "RER B até La Plaine–Stade de France ou RER D até Stade de France–Saint-Denis. Siga a pé pelas placas. Confira os serviços de volta antes de sair."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RER B jusqu’à La Plaine–Stade de France ou RER D jusqu’à Stade de France–Saint-Denis. Suivez les panneaux à pied. Vérifiez les trajets retour avant de partir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RER B a La Plaine–Stade de France o RER D a Stade de France–Saint-Denis. Continúa a pie siguiendo señales. Comprueba el regreso antes de salir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RER B fino a La Plaine–Stade de France oppure RER D fino a Stade de France–Saint-Denis. Prosegui a piedi seguendo i cartelli. Verifica i servizi di ritorno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RER B до La Plaine–Stade de France или RER D до Stade de France–Saint-Denis. Далее пешком по указателям. Заранее проверьте транспорт для возвращения."
          }
        }
      }
    },
    "wem.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current London stadium opened in 2007 on the site of the earlier national stadium. Its arch is a landmark on the approach from Wembley Park."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heutige Londoner Stadion wurde 2007 am Standort des früheren Nationalstadions eröffnet. Der Bogen ist auf dem Weg vom Wembley Park ein markanter Orientierungspunkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estádio atual de Londres abriu em 2007 no local do antigo estádio nacional. Seu arco é um marco no caminho de Wembley Park."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stade actuel de Londres a ouvert en 2007 sur le site de l’ancien stade national. Son arche est un repère depuis Wembley Park."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El actual estadio de Londres abrió en 2007 en el lugar del antiguo estadio nacional. Su arco destaca al llegar desde Wembley Park."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attuale stadio di Londra aprì nel 2007 sul sito del precedente stadio nazionale. Il suo arco è un riferimento arrivando da Wembley Park."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нынешний лондонский стадион открылся в 2007 году на месте прежнего национального стадиона. Его арка — ориентир на подходе от Wembley Park."
          }
        }
      }
    },
    "oly.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened in 1936, the Berlin stadium is part of the Olympic park. Its oval bowl surrounds an athletics track, giving it a different shape from a compact football ground."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das 1936 eröffnete Berliner Stadion ist Teil des Olympiaparks. Die ovale Schüssel umgibt eine Laufbahn und unterscheidet sich von einem reinen Fußballstadion."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaugurado em 1936, o estádio de Berlim faz parte do parque olímpico. Sua estrutura oval envolve uma pista de atletismo, diferente de um campo compacto de futebol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvert en 1936, le stade berlinois fait partie du parc olympique. Son enceinte ovale entoure une piste d’athlétisme, contrairement aux stades de football compacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abierto en 1936, el estadio de Berlín forma parte del parque olímpico. Su forma oval rodea una pista de atletismo, distinta a un campo compacto de fútbol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperto nel 1936, lo stadio di Berlino fa parte del parco olimpico. La struttura ovale circonda una pista di atletica, diversa da uno stadio di solo calcio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берлинский стадион открыт в 1936 году и входит в олимпийский парк. Овальная чаша окружает легкоатлетическую дорожку и отличается от компактной футбольной арены."
          }
        }
      }
    },
    "sdf.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened in 1998, the national stadium stands in Saint-Denis, north of central Paris. It was built for the football world tournament hosted in France that year."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das 1998 eröffnete Nationalstadion liegt in Saint-Denis nördlich von Paris. Es wurde für die damalige Fußball-Weltmeisterschaft in Frankreich gebaut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaugurado em 1998, o estádio nacional fica em Saint-Denis, ao norte de Paris. Foi construído para o torneio mundial de futebol na França naquele ano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvert en 1998, le stade national se trouve à Saint-Denis, au nord de Paris. Il a été construit pour la compétition mondiale de football organisée en France cette année-là."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abierto en 1998, el estadio nacional está en Saint-Denis, al norte de París. Se construyó para el torneo mundial de fútbol de aquel año en Francia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperto nel 1998, lo stadio nazionale si trova a Saint-Denis, a nord di Parigi. Fu costruito per il torneo mondiale di calcio ospitato in Francia quell’anno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Национальный стадион открыт в 1998 году в Сен-Дени, к северу от центра Парижа. Он построен к мировому футбольному турниру, проходившему тогда во Франции."
          }
        }
      }
    }
  },
  "version": "1.0"
}
