    "Only stadium coordinates are sent. No device location is requested. Forecasts are cached for an hour for each match time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only stadium coordinates are sent. No device location is requested. Forecasts are cached for an hour for each match time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Stadionkoordinaten werden gesendet. Kein Standortzugriff. Prognosen werden je Spielzeit eine Stunde gespeichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só as coordenadas do estádio são enviadas. Sem acesso à sua localização. As previsões ficam salvas por uma hora para cada horário de jogo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les coordonnées du stade sont envoyées. Aucune géolocalisation demandée. Les prévisions sont conservées une heure pour chaque horaire de match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envían coordenadas del estadio. No se pide tu ubicación. Los pronósticos se guardan una hora para cada horario de partido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono inviate solo le coordinate dello stadio. Nessuna posizione del dispositivo. Le previsioni restano salvate un’ora per ogni orario di partita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаются только координаты стадиона. Геолокация устройства не запрашивается. Прогноз сохраняется на час для каждого времени матча."
          }
        }
      }
    },
    "MET Norway free access is for non-commercial use. Data: CC BY 4.0. Forecasts are estimates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hourly DWD forecasts via Bright Sky show the nearest available station and valid time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die stündliche DWD-Prognose über Bright Sky zeigt Station und Gültigkeitszeit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A previsão horária do DWD via Bright Sky mostra a estação e o horário."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prévision horaire du DWD via Bright Sky indique la station et l’heure de validité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La previsión horaria de DWD vía Bright Sky indica la estación y la hora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le previsioni orarie DWD tramite Bright Sky indicano stazione e orario."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почасовой прогноз DWD через Bright Sky показывает станцию и время прогноза."
          }
        }
      }
    },
    "Local notifications": {
      "extractionState": "manual",
      "localizations": {
