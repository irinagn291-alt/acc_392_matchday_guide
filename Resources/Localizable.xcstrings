    "Use MET Norway forecasts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use stadium forecasts"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stadionvorhersagen nutzen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
