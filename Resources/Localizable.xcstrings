    "The stadium guide, checklist, notes and personal calendar work without a connection. Widgets use saved data and never request weather themselves. No official fixtures or live scores are supplied.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stadium guide, checklist, notes and personal calendar work without a connection. Widgets use saved data and never request weather themselves. No official fixtures or live scores are supplied."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide, Liste, Notizen und eigener Kalender funktionieren offline. Widgets nutzen gespeicherte Daten und rufen kein Wetter ab. Keine offiziellen Spielpläne oder Live-Ergebnisse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guia, lista, notas e calendário pessoal funcionam offline. Widgets usam dados salvos e não consultam previsão. Sem calendário oficial ou placares ao vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide, liste, notes et calendrier personnel fonctionnent hors ligne. Les widgets utilisent les données enregistrées sans requête météo. Aucun calendrier officiel ni score en direct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guía, lista, notas y calendario personal funcionan sin conexión. Los widgets usan datos guardados sin pedir tiempo. No hay calendario oficial ni resultados en directo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guida, lista, note e calendario personale funzionano offline. I widget usano dati salvati senza richieste meteo. Nessun calendario ufficiale o risultato in diretta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гид, чек-лист, заметки и личный календарь работают без сети. Виджеты используют кэш и сами не запрашивают погоду. Официального расписания и результатов в реальном времени нет."
          }
        }
      }
    },
    "Sources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources"
          }
